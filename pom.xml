<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.jedrock</groupId>
    <artifactId>jedrock</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Jedrock</name>
    <description>Lightweight, highly abstract Minecraft server core with lazy packet parsing. Supports MCPE 1.1.5 and JE 1.12.2.</description>

    <modules>
        <module>jedrock-api</module>
        <module>jedrock-utils</module>
        <module>jedrock-network</module>
        <module>jedrock-gameloop</module>
        <module>jedrock-core</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>

        <!-- Common versions -->
        <netty.version>4.1.111.Final</netty.version>
        <rhino.version>1.7.13</rhino.version>
        <junit.version>5.10.2</junit.version>

        <!-- Project principles -->
        <jedrock.lightweight>true</jedrock.lightweight>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Self modules -->
            <dependency>
                <groupId>com.jedrock</groupId>
                <artifactId>jedrock-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jedrock</groupId>
                <artifactId>jedrock-utils</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jedrock</groupId>
                <artifactId>jedrock-network</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jedrock</groupId>
                <artifactId>jedrock-gameloop</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Netty (used primarily by network for high-perf IO) -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-all</artifactId>
                <version>${netty.version}</version>
            </dependency>

            <!-- Rhino (rhino-runtime: the embed-only engine, no shell/tools) — the script plugin
                 backend. Pure Java, ~1.5 MB, zero transitive deps: the lightweight choice over
                 GraalJS (tens of MB incl. ICU4J). Lives only in core. -->
            <dependency>
                <groupId>org.mozilla</groupId>
                <artifactId>rhino-runtime</artifactId>
                <version>${rhino.version}</version>
            </dependency>

            <!-- Testing -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Published to GitHub Packages by .github/workflows/publish.yml, which authenticates with the
         workflow's own GITHUB_TOKEN — there is no credential here and none is needed to build. To consume
         these from another project you need a token too: GitHub Packages requires authentication even for
         reading a public package, which is its policy and not ours. -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/Hiro-zzz/Jedrock</url>
        </repository>
        <snapshotRepository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/Hiro-zzz/Jedrock</url>
        </snapshotRepository>
    </distributionManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <source>${maven.compiler.source}</source>
                        <target>${maven.compiler.target}</target>
                        <encoding>UTF-8</encoding>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>