<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.jedrock</groupId>
        <artifactId>jedrock</artifactId>
        <version>0.2.3-SNAPSHOT</version>
    </parent>

    <artifactId>jedrock-core</artifactId>
    <name>jedrock-core</name>
    <description>Core server implementation. Glues api + network + gameloop together while remaining lightweight.</description>

    <dependencies>
        <dependency>
            <groupId>com.jedrock</groupId>
            <artifactId>jedrock-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jedrock</groupId>
            <artifactId>jedrock-utils</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jedrock</groupId>
            <artifactId>jedrock-network</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jedrock</groupId>
            <artifactId>jedrock-gameloop</artifactId>
        </dependency>

        <!-- Script plugin backend (Rhino). Only the core knows about it; the api stays neutral. -->
        <dependency>
            <groupId>org.mozilla</groupId>
            <artifactId>rhino-runtime</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- A convenient way to run it: mvn exec:java -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <mainClass>com.jedrock.core.JedrockServer</mainClass>
                </configuration>
            </plugin>

            <!-- The server someone can actually be handed: one jar, every module and dependency in it,
                 a Main-Class in the manifest. `java -jar jedrock.jar` in an empty folder is a server. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <!-- Straight into the project root, beside the worlds/ plugins/ and config a
                                 run uses — target/ is an excluded folder, so a jar built into it is a jar
                                 the IDE never shows you. -->
                            <outputFile>${project.basedir}/../jedrock.jar</outputFile>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.jedrock.core.JedrockServer</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <!-- Signatures of the jars we absorb don't survive being repacked. -->
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
